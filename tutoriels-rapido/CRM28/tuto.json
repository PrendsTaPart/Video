{
 "id": "CRM28",
 "product": "crm",
 "kicker": "Tutoriel RapidoCRM",
 "title": "Créer un sondage",
 "em": "sondage",
 "tag": "1 min · Débutant",
 "intro": 3.0,
 "outro": 4.5,
 "voice": "audio/voix.mp3",
 "transcript": "audio/transcript.json",
 "capture": "captures/ecran.mp4",
 "start_path": "/sondages",
 "type_delay": 22,
 "fixes": {},
 "end_cta": "Retrouvez tous les tutoriels dans l'Académie RapidoSoftware",
 "paragraphs": [
  {
   "key": "intro",
   "text": "Un sondage RapidoCRM s'affiche une question par écran, se remplit en quelques secondes, et adapte son parcours aux réponses."
  },
  {
   "key": "creer",
   "text": "Donnez un nom au sondage et créez-le : il commence par la question de recommandation, notée de zéro à dix."
  },
  {
   "key": "questions",
   "text": "Ajoutez vos questions : choix, oui ou non, texte, e-mail, téléphone, date, étoiles… Par exemple : souhaitez-vous être rappelé ?"
  },
  {
   "key": "logique",
   "text": "Ajoutez ensuite le numéro de téléphone. Puis, avec une règle : si la réponse est non, on va directement à la fin du sondage."
  },
  {
   "key": "partager",
   "text": "Enregistrez, puis partagez : un lien, un code à intégrer dans votre site, ou un QR code."
  },
  {
   "key": "resultats",
   "text": "Les résultats calculent votre NPS, le taux de complétion et la répartition des réponses, avec les commentaires libres et un export CSV."
  },
  {
   "key": "outro",
   "text": "Écoutez vos clients, simplement. Retrouvez tous nos tutoriels dans l'Académie !"
  }
 ],
 "scenes": [
  {
   "at": "intro",
   "wait": 0.4
  },
  {
   "at": "creer",
   "label": "Nouveau sondage",
   "fill": [
    [
     "#nomNouveauSondage",
     "Avis après rendez-vous"
    ]
   ]
  },
  {
   "at": "creer",
   "click": "#boutonCreerSondage",
   "wait": 1.2
  },
  {
   "at": "questions",
   "label": "Les questions",
   "click": "[data-ajouter=\"oui_non\"]",
   "wait": 0.4
  },
  {
   "at": "questions",
   "fill": [
    [
     "[data-champ=\"titre\"][data-i=\"2\"]",
     "Souhaitez-vous être rappelé ?"
    ]
   ]
  },
  {
   "at": "logique",
   "label": "Logique conditionnelle",
   "click": "[data-ajouter=\"telephone\"]"
  },
  {
   "at": "logique",
   "fill_now": [
    [
     "[data-champ=\"titre\"][data-i=\"3\"]",
     "Votre numéro de téléphone"
    ]
   ]
  },
  {
   "at": "logique",
   "click": "[data-ouvrir=\"2\"]"
  },
  {
   "at": "logique",
   "click": "[data-ajouter-regle=\"2\"]"
  },
  {
   "at": "logique",
   "select": [
    [
     "[data-regle-si=\"0\"][data-i=\"2\"]",
     "Non"
    ],
    [
     "[data-regle-aller=\"0\"][data-i=\"2\"]",
     "Fin du sondage"
    ]
   ],
   "wait": 0.6,
   "zone": ".regle"
  },
  {
   "at": "partager",
   "label": "Partager",
   "click": "#enregistrerSondage",
   "wait": 0.8
  },
  {
   "at": "partager",
   "click": "#tab-partager",
   "wait": 0.4
  },
  {
   "at": "resultats",
   "label": "Résultats",
   "goto": "/sondages",
   "wait": 0.3
  },
  {
   "at": "resultats",
   "eval": "(()=>{const tr=[...document.querySelectorAll('tr')].find(x=>/Satisfaction après livraison/.test(x.innerText));const a=tr&&[...tr.querySelectorAll('a')].find(a=>/resultats/.test(a.href));if(a)location.href=a.href;})()",
   "wait": 1.5
  },
  {
   "at": "outro",
   "top": true
  }
 ],
 "thumb_shot": "fin.png"
}