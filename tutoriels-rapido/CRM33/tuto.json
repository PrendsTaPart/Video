        ],
        [
          ".modal.show input[type=datetime-local] >> nth=1",
          "2026-11-17T15:30"
        ]
      ],
      "zone": ".modal.show .modal-content"
    },
    {
      "at": "type",
      "label": "Type et invités",
      "click": ".modal.show label[for=defaultRadio2]",
