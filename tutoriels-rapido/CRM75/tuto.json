{
  "product": "crm",
  "kicker": "Tutoriel RapidoCRM",
  "intro": 3.0,
  "outro": 4.5,
  "voice": "audio/voix.mp3",
  "transcript": "audio/transcript.json",
  "capture": "captures/ecran.mp4",
  "type_delay": 45,
  "fixes": {},
  "thumb_shot": "fin.png",
  "end_cta": "Retrouvez tous les tutoriels dans l'Académie RapidoSoftware",
  "id": "CRM75",
  "title": "Dessiner sa stratégie avec la Marketing Map",
  "em": "Marketing Map",
  "tag": "3 min · Intermédiaire",
  "start_path": "/marketing-map",
  "scenes": [
    {
      "at": "intro",
      "wait": 0.4
    },
    {
      "at": "modeles",
      "label": "Cinq modèles prêts à l'emploi",
      "scroll": "Modèles prêts à l’emploi",
      "zone": ".row:has(input[name=modele])"
    },
    {
      "at": "modeles",
      "hover": "form:has(input[value=carte_devis])"
    },
    {
      "at": "creer",
      "label": "Créer une carte",
      "top": true,
      "fill": [
        [
          "#mm-nom",
          "Salon de l'habitat"
        ]
      ]
    },
    {
      "at": "creer",
      "select": [
        [
          "select[name=modele]",
          "Carte digitale + devis en ligne"
        ]
      ]
    },
    {
      "at": "creer",
      "click": "form:has(#mm-nom) button",
      "wait": 1.5
    },
    {
      "at": "carte",
      "label": "Des blocs et des conditions",
      "zone": "#mm-zone"
    },
    {
      "at": "carte",
      "hover": ".mm-etiquette >> nth=0"
    },
    {
      "at": "relier",
      "label": "Relier vos vrais objets",
      "click": ".mm-bloc >> nth=0",
      "wait": 0.8
    },
    {
      "at": "relier",
      "zone": "#mm-panneau .border",
      "select": [
        [
          "#mm-panneau select[aria-label=\"Objet de votre société\"]",
          "Léa Martin"
        ]
      ]
    },
    {
      "at": "relier",
      "click": ".mm-bloc >> nth=1",
      "wait": 0.8
    },
    {
      "at": "relier",
      "select": [
        [
          "#mm-panneau select[aria-label=\"Objet de votre société\"]",
          "Demande de devis"
        ]
      ]
    },
    {
      "at": "ajouter",
      "label": "Ajouter un bloc",
      "click": ".mm-type:has-text(\"SMS\")",
      "wait": 0.8
    },
    {
      "at": "ajouter",
      "fill": [
        [
          "#mm-panneau input >> nth=0",
          "SMS de rappel"
        ]
      ]
    },
    {
      "at": "ajouter",
      "select": [
        [
          "#mm-panneau select >> nth=-1",
          "Achat"
        ]
      ],
      "wait": 0.6
    },
    {
      "at": "activer",
      "label": "Activer en toute sécurité",
      "click": "#mm-enregistrer",
      "wait": 0.8
    },
    {
      "at": "activer",
      "click": "#mm-activer",
      "wait": 2.0
    },
    {
      "at": "confirmer",
      "click": "#mm-confirmer",
      "wait": 0.4
    },
    {
      "at": "confirmer",
      "click": "#mm-confirmer-activation",
      "wait": 1.5
    },
    {
      "at": "confirmer",
      "zone": ".modal.show .modal-content"
    },
    {
      "at": "outro",
      "eval": "document.querySelectorAll('.modal.show .btn-close').forEach(b => b.click())",
      "wait": 0.6
    }
  ],
  "paragraphs": [
    {
      "key": "intro",
      "text": "Votre stratégie marketing tient sur une seule carte : contenus, formulaires, e-mails, appels et ventes, reliés entre eux. Voici la Marketing Map."
    },
    {
      "key": "modeles",
      "text": "Partez d'une carte vierge ou d'un des cinq modèles : inbound, prospection, parcours d'équipe, carte digitale et devis, tunnel lead magnet."
    },
    {
      "key": "creer",
      "text": "Donnez un nom, choisissez le modèle Carte digitale et devis en ligne, puis créez la carte."
    },
    {
      "key": "carte",
      "text": "Chaque bloc est une étape de votre parcours, colorée selon la phase : découverte, considération, conversion. Les liens portent une condition : a cliqué, s'est inscrit, sans réponse après deux jours."
    },
    {
      "key": "relier",
      "text": "Cliquez sur un bloc pour le régler, et reliez-le à un vrai objet de votre CRM : ici la carte de visite de Léa, puis le formulaire de demande de devis."
    },
    {
      "key": "ajouter",
      "text": "Ajoutez un bloc depuis la bibliothèque, donnez-lui un titre, et reliez-le au bloc suivant. Tout est enregistré automatiquement, et vous pouvez annuler."
    },
    {
      "key": "activer",
      "text": "Quand la carte est prête, cliquez sur Activer : RapidoCRM vous montre d'abord ce qu'il va faire, et ce qu'il reste à vérifier."
    },
    {
      "key": "confirmer",
      "text": "Confirmez : la séquence d'e-mails est préparée, mais elle reste inactive. Rien n'est envoyé à vos contacts sans votre accord."
    },
    {
      "key": "outro",
      "text": "Votre parcours est dessiné et prêt à suivre vos prospects. Retrouvez tous nos tutoriels dans l'Académie !"
    }
  ]
}