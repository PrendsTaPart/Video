   "click": ".sk-main .sk-ir button:has-text(\"Répondre\")",
   "wait": 1.2,
   "zone": ".sk-main .sk-msg >> nth=-1"
  },
  {
   "at": "outro",
   "label": "Répondu",
   "goto": "/messagerie",
   "click": ".sk-conv >> text=marketing",
   "wait": 1.0,
   "zone": ".sk-main .sk-ir",
   "zone_closest": ".sk-msg"
