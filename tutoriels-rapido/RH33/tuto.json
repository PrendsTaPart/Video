   "text": "Dans ce tutoriel, un collaborateur répond à une demande d'information dans la messagerie."
  },
  {
   "key": "canal",
   "text": "Les conversations qui contiennent une mention ou une demande pour vous sont signalées."
  },
  {
   "key": "repondre",
   "text": "Ouvrez la demande, écrivez votre réponse directement dans le message, puis envoyez."
  },
  {
   "key": "deblocage",
   "text": "La demande passe à Répondu : si une tâche l'attendait, elle repart aussitôt."
  },
  {
   "key": "outro",
   "text": "Une réaction ou un vu ne vaut pas validation : seule votre réponse compte."
  }
 ],
 "scenes": [
  {
   "at": "intro",
   "wait": 0.3
  },
  {
   "at": "canal",
