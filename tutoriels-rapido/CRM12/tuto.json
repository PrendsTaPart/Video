  "start_path": "/facturation",
  "type_delay": 30,
  "fixes": {"TVA": "TVA", "HT": "HT", "PDF": "PDF"},
  "end_cta": "Prochain épisode : factures et suivi des paiements",
  "paragraphs": [
    {"key": "intro", "text": "Dans ce tutoriel, on crée un devis dans RapidoCRM et on l'envoie au client, sans quitter le logiciel."},
    {"key": "liste", "text": "Dans Factures, l'onglet Devis liste tous vos devis, avec leur statut : en attente, accepté ou refusé."},
    {"key": "design", "text": "Le bouton Créer un devis ouvre le formulaire. On ajoute son logo et on choisit la couleur du document."},
    {"key": "client", "text": "On sélectionne le client, puis on coche les produits du catalogue : les prix et la TVA se remplissent tout seuls."},
    {"key": "conditions", "text": "On fixe la période de validité, une remise si besoin, le délai et le mode de paiement."},
    {"key": "envoi", "text": "Enfin, on choisit d'envoyer le devis par e-mail, avec un modèle de message tout prêt."},
    {"key": "suivi", "text": "Dans la liste, le menu de chaque devis permet de le visualiser, de le télécharger en PDF ou de le renvoyer."},
    {"key": "apercu", "text": "Votre client reçoit un devis clair, à vos couleurs, qu'il peut signer en ligne."},
    {"key": "outro", "text": "Dans le prochain tutoriel, on transforme ce devis en facture et on suit les paiements. À tout de suite !"}
  ],
  "scenes": [
    {"at": "intro", "wait": 0.3},
    {"at": "liste", "label": "Les devis", "click": "button[data-bs-target=\"#devislist\"]", "wait": 0.6, "zone": [400, 570, 1370, 500]},
    {"at": "design", "label": "Un nouveau devis", "click": "#devislist button:has-text(\"Créer un devis\")"},
    {"at": "design", "click": "#devislist .modal.show label[for=\"devischarte42\"]", "zone": [680, 120, 500, 380]},
    {"at": "client", "label": "Client et produits", "scroll": "#devislist .modal.show label:has-text(\"Entreprise*\")",
     "select": [["#devislist .modal.show select >> nth=0", {"index": 3}]]},
    {"at": "client", "click": "#devislist .modal.show .cardBox input[type=checkbox] >> nth=0"},
    {"at": "client", "click": "#devislist .modal.show .cardBox input[type=checkbox] >> nth=2", "zone": [680, 520, 500, 420]},
    {"at": "conditions", "label": "Conditions", "scroll": "#devislist .modal.show label:has-text(\"Date de début\")",
     "fill": [["#devislist .modal.show input[type=date] >> nth=0", "2026-11-15"], ["#devislist .modal.show input[type=date] >> nth=1", "2026-12-15"]],
     "zone": [680, 120, 500, 700]},
    {"at": "conditions", "click": "#devislist .modal.show #paiement3",
     "select": [["#devislist .modal.show select:has(option[value=\"14 jours\"])", "14 jours"]]},
    {"at": "envoi", "label": "Envoi par e-mail", "scroll": "#devislist .modal.show label[for=\"Oui2\"]", "click": "#devislist .modal.show #Oui2", "wait": 0.5,
     "zone": "#devislist .modal.show label[for=\"Oui2\"]", "zone_closest": ".col-12"},
    {"at": "suivi", "label": "Suivre ses devis", "click": "#devislist .modal.show .btn-close"},
    {"at": "suivi", "click": "#devislist tbody tr:first-child .dropdown-toggle", "zone": "#devislist .dropdown-menu.show"},
    {"at": "apercu", "label": "Le devis du client", "goto": "/facturation/devis/8", "wait": 0.6, "scroll": "h5:has-text(\"Informations du devis\")", "zone": [500, 100, 920, 800]},
    {"at": "outro", "wait": 0.3}
