{
 "id": "CRM18",
 "product": "crm",
 "kicker": "Tutoriel RapidoCRM",
 "title": "Campagnes SMS : cible, compteur et aperçu",
 "em": "SMS",
 "tag": "1 min · Débutant",
 "intro": 3.0,
 "outro": 4.5,
 "voice": "audio/voix.mp3",
 "transcript": "audio/transcript.json",
 "capture": "captures/ecran.mp4",
 "start_path": "/ajout-campagne-sms",
 "type_delay": 30,
 "fixes": {
  "Unicode": "Unicode"
 },
 "end_cta": "Retrouvez tous les tutoriels dans l'Académie RapidoSoftware",
 "paragraphs": [
  {
   "key": "intro",
   "text": "Envoyez un SMS aux bonnes personnes, au bon moment, et sans mauvaise surprise sur la facture."
  },
  {
   "key": "cible",
   "text": "Choisissez la cible. Avec Écosystème, visez par exemple les gagnants d'un jeu concours qui n'ont pas encore retiré leur lot."
  },
  {
   "key": "compte",
   "text": "RapidoCRM compte aussitôt les destinataires qui ont un numéro de téléphone, sans les désinscrits."
  },
  {
   "key": "modele",
   "text": "Choisissez ensuite un modèle, le portefeuille concerné, et la date d'envoi."
  },
  {
   "key": "texte",
   "text": "À l'étape suivante, retouchez le texte, et insérez le prénom ou la ville en un clic."
  },
  {
   "key": "compteur",
   "text": "Le compteur affiche les caractères et les SMS facturés. Ici, une apostrophe courbe et un A accentué font passer le message en Unicode : deux SMS au lieu d'un. On les remplace, et l'on revient à un seul SMS."
  },
  {
   "key": "apercu",
   "text": "L'aperçu montre le message final, avec la mention STOP obligatoire. Envoyez-vous un test avant de valider."
  },
  {
   "key": "creneaux",
   "text": "Les envois partent du lundi au samedi, de huit heures à vingt heures, hors jours fériés."
  },
  {
   "key": "outro",
   "text": "Des SMS efficaces, et maîtrisés. Retrouvez tous nos tutoriels dans l'Académie !"
  }
 ],
 "scenes": [
  {
   "at": "intro",
   "wait": 0.4
  },
  {
   "at": "cible",
   "label": "La cible",
   "select": [
    [
     "select:has(option:has-text(\"Par segment\"))",
     "Écosystème : pipeline, jeu, sondage, formulaire, engagement…"
    ]
   ],
   "wait": 0.4
  },
  {
   "at": "cible",
   "select": [
    [
     "select:has(option:has-text(\"Choisir une source\"))",
     "Participants d’un jeu"
    ]
   ],
   "wait": 0.4
  },
  {
   "at": "cible",
   "select": [
    [
     "select:has(option:has-text(\"Choisir…\"))",
     "Roue du printemps"
    ]
   ],
   "wait": 0.4
  },
  {
   "at": "cible",
   "select": [
    [
     "select:has(option:has-text(\"Tous les participants\"))",
     {
      "value": "non_remis"
     }
    ]
   ],
   "wait": 0.6
  },
  {
   "at": "compte",
   "label": "Les destinataires",
   "zone": ".audience-apercu"
  },
  {
   "at": "modele",
   "label": "Modèle et date",
   "click": ".slidecardBox:has-text(\"Lot à retirer\") label:has-text(\"Choisir\")",
   "wait": 0.4
  },
  {
   "at": "modele",
   "click": "#showTemplateSmsModal button:has-text(\"Utiliser ce modèle\")"
  },
  {
   "at": "modele",
   "click": ".tagify__input",
   "wait": 0.4
  },
  {
   "at": "modele",
   "click": ".tagify__dropdown__item >> nth=0"
  },
  {
   "at": "modele",
   "fill": [
    [
     "input[type=\"datetime-local\"]",
     "2026-11-20T10:00"
    ]
   ]
  },
  {
   "at": "texte",
   "label": "Le texte",
   "click": "button:has-text(\"Suivant\") >> visible=true",
   "wait": 0.6,
   "zone": "#texteSms"
  },
  {
   "at": "compteur",
   "label": "SMS facturés",
   "zone": ".sms-outils"
  },
  {
   "at": "compteur",
   "eval": "(()=>{const t=document.getElementById('texteSms');t.value=t.value.replace(/’/g,\"'\").replace(/À/g,'A');t.dispatchEvent(new Event('input',{bubbles:true}));})()",
   "wait": 0.6
  },
  {
   "at": "apercu",
   "label": "Aperçu et test",
   "fill": [
    [
     ".sms-outils input[type=\"tel\"]",
     "06 12 34 56 78"
    ]
   ],
   "zone": ".sms-telephone",
   "zone_closest": ".row"
  },
  {
   "at": "creneaux",
   "label": "Créneaux d’envoi",
   "hover": ".sms-outils button:has(.ti-send)"
  },
  {
   "at": "outro",
   "top": true
  }
 ],
 "thumb_shot": "fin.png"
}