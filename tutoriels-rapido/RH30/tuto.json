  {
   "key": "intro",
   "text": "Dans ce tutoriel, on confie une tâche du Kanban à un employé IA."
  },
  {
   "key": "ouvrir",
   "text": "Ouvrez la tâche. En bas de sa fiche, le panneau Employé IA permet de lui confier le travail."
  },
  {
   "key": "mode",
   "text": "Choisissez le mode et l'employé IA, puis écrivez ses instructions : ce qu'il doit produire, pour qui, et sous quelle forme."
  },
  {
   "key": "outils",
   "text": "Cochez les outils qu'il peut consulter. Il ne peut que lire : aucune action n'est faite à votre place."
  },
  {
   "key": "outro",
   "text": "Enregistrez. Son livrable vous sera soumis pour validation avant toute suite."
  }
 ],
 "scenes": [
  {
   "at": "intro",
   "goto_file": "boutique-taches.txt",
   "wait": 0.3
  },
  {
   "at": "ouvrir",
   "label": "Le panneau Employé IA",
   "click": ".kanban-item:has-text(\"Rédiger les fiches produits\")",
   "wait": 0.5
