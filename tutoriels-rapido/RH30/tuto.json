  {
   "at": "ouvrir",
   "hover": ".modal.show select[id^=ai-mode]",
   "zone": ".modal.show select[id^=ai-mode]",
   "zone_closest": ".border, .card, div.mt-4"
  },
  {
   "at": "mode",
   "label": "Mode et instructions",
   "select": [
    [
     ".modal.show select[id^=ai-mode]",
     {
      "index": 1
     }
    ]
   ],
   "wait": 0.6
  },
  {
   "at": "mode",
   "select": [
