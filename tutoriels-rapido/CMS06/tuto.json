{
  "id": "CMS06",
  "product": "cms",
  "kicker": "Tutoriel RapidoCMS",
  "title": "Créer son kit de marque",
  "em": "kit de marque",
  "tag": "2 min · Débutant",
  "intro": 3.0,
  "outro": 4.5,
  "voice": "audio/voix.mp3",
