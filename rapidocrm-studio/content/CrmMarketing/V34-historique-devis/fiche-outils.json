{
  "outils": [
    {
      "nom": "list_devis",
      "description": "Lister les devis avec filtres (statut, entreprise, recherche, période).",
      "parametres": [
        {
          "nom": "statut",
          "type": "string",
          "obligatoire": false,
          "valeurs_autorisees": [
            "brouillon",
            "en_attente",
            "accepte",
            "refuse",
            "expire"
          ],
          "description": ""
        },
        {
          "nom": "entreprise_id",
          "type": "integer",
          "obligatoire": false,
          "valeurs_autorisees": [],
