3, 7], ["changer", 26.39, 7], ["demain.", 26.63, 7], ["Quatre", 27.19, 8], ["ton", 27.77, 8], ["agent", 27.83, 8], ["de", 28.07, 8], ["contenu.", 28.23, 8], ["Tes", 28.61, 9], ["photos,", 28.83, 9], ["ton", 29.45, 9], ["logo,", 29.55, 9], ["tes", 30.13, 9], ["couleurs.", 30.23, 9], ["Il", 30.83, 9], ["te", 30.89, 9], ["prépare", 31.01, 9], ["les", 31.39, 9], ["posts", 31.6, 9], ["de", 31.81, 9], ["la", 31.89, 9], ["semaine.", 31.99, 9], ["Cinq", 32.57, 10], ["une", 33.15, 10], ["équipe", 33.31, 10], ["d'IA.", 33.63, 10], ["Une", 34.05, 11], ["qui", 34.19, 11], ["répond", 34.35, 11], ["au", 34.69, 11], ["téléphone,", 35.03, 11], ["une", 35.37, 11], ["qui", 35.53, 11], ["suit", 35.69, 11], ["les", 35.83, 11], ["chiffres.", 35.99, 11], ["Chez", 36.43, 11], ["moi,", 36.65, 11], ["c'est", 36.99, 11], ["Caroline", 37.09, 11], ["et", 37.45, 11], ["PrediBot.", 37.75, 11], ["Le", 38.51, 12], ["guide", 38.61, 12], ["des", 38.81, 12], ["cinq", 39.01, 12], ["projets", 39.23, 12], ["écris", 39.81, 12], ["WEEKEND", 40.17, 12], ["en", 40.63, 12], ["commentaire.", 40.85, 12]], "lines": [{"t0": 0.35, "t1": 2.33, "txt": "Je t'apprends à construire ça en un week-end."}, {"t0": 2.69, "t1": 7.79, "txt": "Cinq projets utiles à faire avec Claude en un week-end. Et une fois faits, ils travaillent pour toi tous les jours."}, {"t0": 8.21, "t1": 9.49, "txt": "Un : ton tableau du matin."}, {"t0": 9.78, "t1": 13.21, "txt": "Réservations, stocks bas, avis du jour. Tout sur une seule page."}, {"t0": 13.67, "t1": 15.03, "txt": "Deux : ton deuxième cerveau."}, {"t0": 15.21, "t1": 21.17, "txt": "Tu ranges tes factures et tes contrats dans un dossier, et tu poses tes questions. Quand finit mon bail ? Combien j'ai payé la mozzarella le mois dernier ?"}, {"t0": 21.47, "t1": 22.79, "txt": "Trois : le bilan du soir."}, {"t0": 23.13, "t1": 26.91, "txt": "Chaque soir, tu lui dis ce qui a marché et ce qui a coincé. Il te dit quoi changer demain."}, {"t0": 27.19, "t1": 28.61, "txt": "Quatre : ton agent de contenu."}, {"t0": 28.61, "t1": 32.23, "txt": "Tes photos, ton logo, tes couleurs. Il te prépare les posts de la semaine."}, {"t0": 32.57, "t1": 33.87, "txt": "Cinq : une équipe d'IA."}, {"t0": 34.05, "t1": 38.23, "txt": "Une qui répond au téléphone, une qui suit les chiffres. Chez moi, c'est Caroline et PrediBot."}, {"t0": 38.51, "t1": 41.35, "txt": "Le guide des cinq projets : écris WEEKEND en commentaire."}]}