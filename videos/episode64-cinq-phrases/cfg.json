t", 27.71, 9], ["tes", 27.87, 9], ["clients", 27.99, 9], ["qui", 28.19, 9], ["le", 28.39, 9], ["fassent.", 28.59, 9], ["Cinq", 28.79, 10], ["si", 29.69, 10], ["ça", 29.87, 10], ["rate", 30.03, 10], ["quand", 30.21, 10], ["même,", 30.37, 10], ["analyse", 30.78, 10], ["ce", 31.19, 10], ["qui", 31.35, 10], ["n'a", 31.47, 10], ["pas", 31.57, 10], ["marché,", 31.71, 10], ["et", 32.05, 10], ["pourquoi.", 32.37, 10], ["Tu", 32.97, 11], ["sais", 33.11, 11], ["quoi", 33.31, 11], ["changer", 33.47, 11], ["la", 33.69, 11], ["prochaine", 33.85, 11], ["fois.", 34.09, 11], ["Ce", 34.67, 12], ["ne", 34.72, 12], ["sont", 34.83, 12], ["pas", 34.93, 12], ["des", 35.07, 12], ["formules", 35.19, 12], ["magiques.", 35.47, 12], ["Juste", 36.09, 12], ["les", 36.49, 12], ["bonnes", 36.61, 12], ["questions.", 36.87, 12], ["Écris", 37.43, 13], ["PHRASES", 37.66, 13], ["en", 37.89, 13], ["commentaire,", 38.01, 13], ["je", 38.71, 13], ["t'envoie", 38.77, 13], ["les", 39.05, 13], ["cinq.", 39.13, 13]], "lines": [{"t0": 0.35, "t1": 2.97, "txt": "Je t'apprends à réfléchir comme un pro, en cinq phrases."}, {"t0": 3.41, "t1": 8.73, "txt": "Un nouveau plat, la livraison, un deuxième resto ? Avant de dépenser un euro, dis ces cinq phrases à Claude."}, {"t0": 9.13, "t1": 11.43, "txt": "Un : explique-moi ce sujet avec des mots très simples."}, {"t0": 11.69, "t1": 13.53, "txt": "Tu sais enfin où tu mets les pieds."}, {"t0": 13.59, "t1": 15.39, "txt": "Deux : donne-moi dix versions différentes."}, {"t0": 15.77, "t1": 18.35, "txt": "Dix noms, dix recettes, dix prix. C'est toi qui choisis."}, {"t0": 18.59, "t1": 20.81, "txt": "Trois : quels risques cachés vois-tu dans mon plan ?"}, {"t0": 21.07, "t1": 22.81, "txt": "Il relit tout et te montre les pièges."}, {"t0": 23.03, "t1": 25.17, "txt": "Quatre : défends le point de vue opposé au mien."}, {"t0": 25.43, "t1": 28.99, "txt": "Il te donne toutes les raisons d'avoir tort. Avant que ce soit tes clients qui le fassent."}, {"t0": 28.79, "t1": 32.71, "txt": "Cinq : si ça rate quand même, analyse ce qui n'a pas marché, et pourquoi."}, {"t0": 32.97, "t1": 34.35, "txt": "Tu sais quoi changer la prochaine fois."}, {"t0": 34.67, "t1": 37.13, "txt": "Ce ne sont pas des formules magiques. Juste les bonnes questions."}, {"t0": 37.43, "t1": 39.33, "txt": "Écris PHRASES en commentaire, je t'envoie les cinq."}]}