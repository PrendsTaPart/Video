{"dur": 27.47, "words": [["Tu", 0.35, 0], ["en", 0.47, 0], ["as", 0.59, 0], ["marre", 0.69, 0], ["de", 0.99, 0], ["remettre", 1.07, 0], ["ton", 1.37, 0], ["propre", 1.53, 0], ["projet", 1.85, 0], ["à", 2.27, 0], ["plus", 2.37, 0], ["tard ?", 2.49, 0], ["Alex", 3.11, 1], ["se", 3.33, 1], ["lance,", 3.63, 1], ["sans", 4.07, 1], ["montrer", 4.25, 1], ["son", 4.51, 1], ["visage", 4.67, 1], ["ni", 5.09, 1], ["sa", 5.35, 1], ["voix.", 5.55, 1], ["Il", 5.97, 2], ["choisit", 6.05, 2], ["une", 6.39, 2], ["niche,", 6.55, 2], ["un", 7.01, 2], ["vrai", 7.11, 2], ["problème,", 7.33, 2], ["et", 7.99, 2], ["crée", 8.07, 2], ["un", 8.29, 2], ["produit", 8.37, 2], ["digital", 8.63, 2], ["pour", 9.07, 2], ["le", 9.29, 2], ["résoudre.", 9.41, 2], ["Avec", 10.01, 3], ["Claude,", 10.17, 3], ["il", 10.69, 3], ["crée", 10.81, 3], ["des", 11.03, 3], ["vidéos", 11.13, 3], ["animées,", 11.45, 3], ["trois", 12.03, 3], ["à", 12.25, 3], ["quatre", 12.45, 3], ["par", 12.71, 3], ["jour.", 12.93, 3], ["La", 13.43, 4], ["création", 13.51, 4], ["et", 13.95, 4], ["la", 14.05, 4], ["publication", 14.13, 4], ["tournent", 14.47, 4], ["seules,", 15.05, 4], ["une", 15.47, 4], ["fois", 15.59, 4], ["le", 15.73, 4], ["système", 15.85, 4], ["réglé.", 16.09, 4], ["La", 16.71, 5], ["septième", 16.79, 5], ["vidéo", 17.23, 5], ["perce", 17.53, 5], ["elle", 18.11, 5], ["envoie", 18.23, 5], ["des", 18.45, 5], ["visiteurs", 18.59, 5], ["vers", 19.01, 5], ["son", 19.11, 5], ["guide.", 19.31, 5], ["Les", 19.77, 6], ["ventes", 19.87, 6], ["s'enchaînent,", 20.21, 6], ["sans", 20.79, 6], ["qu'il", 20.99, 6], ["soit", 21.19, 6], ["devant", 21.37, 6], ["la", 21.55, 6], ["caméra.", 21.71, 6], ["Écris", 22.31, 7], ["QUITTE", 22.57, 7], ["en", 22.83, 7], ["commentaire,", 23.09, 7], ["je", 23.83, 7], ["t'envoie", 23.91, 7], ["le", 24.23, 7], ["guide.", 24.29, 7]], "lines": [{"t0": 0.35, "t1": 2.71, "txt": "Tu en as marre de remettre ton propre projet à plus tard ?"}, {"t0": 3.11, "t1": 5.75, "txt": "Alex se lance, sans montrer son visage ni sa voix."}, {"t0": 5.97, "t1": 9.85, "txt": "Il choisit une niche, un vrai problème, et crée un produit digital pour le résoudre."}, {"t0": 10.01, "t1": 13.15, "txt": "Avec Claude, il crée des vidéos animées, trois à quatre par jour."}, {"t0": 13.43, "t1": 16.55, "txt": "La création et la publication tournent seules, une fois le système réglé."}, {"t0": 16.71, "t1": 19.51, "txt": "La septième vidéo perce : elle envoie des visiteurs vers son guide."}, {"t0": 19.77, "t1": 22.05, "txt": "Les ventes s'enchaînent, sans qu'il soit devant la caméra."}, {"t0": 22.31, "t1": 24.47, "txt": "Écris QUITTE en commentaire, je t'envoie le guide."}]}