{
  "$schema": "https://design-tokens.org/format/schema.json",
  "meta": {
    "name": "EatNow",
    "version": "1.0.0",
    "description": "EatNow brand color tokens."
  },
  "color": {
    "foundation": {
      "ink": {
        "value": "#141210",
        "description": "Primary dark surface. Warmed black, never pure #000."
      },
      "paper": {
        "value": "#FAF8F2",
        "description": "Default UI background. Warmed white."
      },
      "navy": {
        "value": "#10386B",
        "description": "The only accent — CTAs, links, selected states."
      },
      "beige": {
        "value": "#DDD6C6",
        "description": "Hospitality surface. Editorial covers, print."
      }
    },
    "surface": {
      "canvas": {
        "value": "#FAF8F2"
      },
      "subtle": {
        "value": "#F2EDE2"
      },
      "warm": {
        "value": "#DDD6C6"
      }
    },
    "border": {
      "default": {
        "value": "#C4BFB2"
      },
      "strong": {
        "value": "#A8A399"
      }
    },
    "text": {
      "primary": {
        "value": "#141210"
      },
      "body": {
        "value": "#2B2821"
      },
      "secondary": {
        "value": "#5A564C"
      },
      "muted": {
        "value": "#8C887C"
      }
    },
    "functional": {
      "success": {
        "value": "#3D7A58",
        "tint": "#E8EFE3"
      },
      "warning": {
        "value": "#C68A3A",
        "tint": "#F3EAD8"
      },
      "error": {
        "value": "#B84842",
        "tint": "#F0DFD9"
      },
      "info": {
        "value": "#10386B",
        "tint": "#DCE4EC"
      }
    }
  }
}