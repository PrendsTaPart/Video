les", 29.91, 11], ["réseaux", 30.05, 11], ["en", 30.39, 11], ["une", 30.53, 11], ["seule", 30.73, 11], ["fois.", 30.89, 11], ["Le", 31.39, 12], ["plus", 31.47, 12], ["fou ?", 31.65, 12], ["Ils", 31.9, 12], ["se", 32.15, 12], ["parlent", 32.32, 12], ["tous.", 32.49, 12], ["Je", 33.05, 12], ["décris,", 33.15, 12], ["Claude", 33.61, 12], ["orchestre,", 34.01, 12], ["et", 34.61, 12], ["ça", 34.79, 12], ["sort.", 34.93, 12], ["L'agence,", 35.43, 13], ["maintenant,", 35.85, 13], ["c'est", 36.43, 13], ["toi.", 36.59, 13], ["La", 37.05, 14], ["liste", 37.15, 14], ["avec", 37.43, 14], ["les", 37.53, 14], ["liens", 37.82, 14], ["écris", 38.12, 14], ["OUTILS", 38.41, 14], ["en", 38.93, 14], ["commentaire.", 39.11, 14]], "lines": [{"t0": 0.35, "t1": 2.47, "txt": "Claude a tué le business des agences web."}, {"t0": 2.85, "t1": 9.45, "txt": "Avant, un site pour un resto, c'était une agence, des semaines, et beaucoup d'argent. Aujourd'hui, voilà les outils que j'utilise vraiment."}, {"t0": 9.73, "t1": 10.72, "txt": "Un : Lovable."}, {"t0": 10.91, "t1": 14.71, "txt": "Je décris le site, il le construit. Mes pages, mes formulaires, mes réservations."}, {"t0": 15.03, "t1": 15.91, "txt": "Deux : Claude."}, {"t0": 16.21, "t1": 20.11, "txt": "C'est mon chef de chantier. Il écrit les textes, vérifie tout, et pilote les autres outils."}, {"t0": 20.33, "t1": 21.19, "txt": "Trois : Canva."}, {"t0": 21.45, "t1": 23.09, "txt": "Pour les affiches et les menus à imprimer."}, {"t0": 23.27, "t1": 24.33, "txt": "Quatre : ElevenLabs."}, {"t0": 24.59, "t1": 26.71, "txt": "Pour la voix de mes vidéos. Celle que tu entends en ce moment."}, {"t0": 26.93, "t1": 27.94, "txt": "Cinq : RapidoCMS."}, {"t0": 28.15, "t1": 31.13, "txt": "Pour programmer les posts sur tous les réseaux en une seule fois."}, {"t0": 31.39, "t1": 35.21, "txt": "Le plus fou ? Ils se parlent tous. Je décris, Claude orchestre, et ça sort."}, {"t0": 35.43, "t1": 36.75, "txt": "L'agence, maintenant, c'est toi."}, {"t0": 37.05, "t1": 39.61, "txt": "La liste avec les liens : écris OUTILS en commentaire."}]}