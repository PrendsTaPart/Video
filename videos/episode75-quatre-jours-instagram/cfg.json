9, 8], ["Écris", 28.73, 9], ["PUBLIE", 29.27, 9], ["en", 29.67, 9], ["commentaire,", 29.73, 9], ["je", 30.47, 9], ["t'envoie", 30.52, 9], ["ma", 30.83, 9], ["méthode.", 30.89, 9]], "lines": [{"t0": 0.35, "t1": 3.63, "txt": "Un créateur a laissé Claude gérer son Instagram pendant quatre jours."}, {"t0": 3.87, "t1": 5.75, "txt": "Un compte tout neuf, sans abonnés."}, {"t0": 5.79, "t1": 8.37, "txt": "Le premier jour, Claude monte ses premières vidéos courtes."}, {"t0": 8.55, "t1": 11.47, "txt": "Le deuxième jour, il en publie plus, sur un sujet qui intéresse."}, {"t0": 11.75, "t1": 14.59, "txt": "Le troisième jour, il montre une méthode, étape par étape."}, {"t0": 14.79, "t1": 18.85, "txt": "Le quatrième jour, il publie plusieurs fois dans la journée, et une vidéo explose."}, {"t0": 19.13, "t1": 22.83, "txt": "La leçon : publier souvent, sur un vrai sujet, en montrant comment faire."}, {"t0": 23.07, "t1": 27.01, "txt": "Moi, c'est ce que je fais avec RapidoCMS : je parle, il publie sur tous mes réseaux."}, {"t0": 27.19, "t1": 28.47, "txt": "Et rien ne part sans mon accord."}, {"t0": 28.73, "t1": 31.29, "txt": "Écris PUBLIE en commentaire, je t'envoie ma méthode."}]}